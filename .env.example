# ── Higher or Lower — Environment Variables ──────────────────────────────────
# Copy this file to .env.local for local development.
# NEVER commit .env.local — it is in .gitignore.

# ── API ───────────────────────────────────────────────────────────────────────
# Spring Boot runs on port 8080 with no context path
VITE_API_BASE_URL=http://localhost:8080/api

# Production examples:
# VITE_API_BASE_URL=https://your-app.onrender.com/api        (Render)
# VITE_API_BASE_URL=https://api.yourdomain.com/api           (custom)

# ── App Meta (optional) ───────────────────────────────────────────────────────
# VITE_APP_URL=https://higherorlower.yourdomain.com
